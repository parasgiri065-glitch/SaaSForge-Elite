# =============================================================================
# SaaSForge Elite — environment template
#
# 1. Copy this file:
#      cp .env.example .env.local
# 2. Fill every REQUIRED value. Leave OPTIONAL keys blank until you need them.
# 3. Never commit .env.local (gitignored). This file is the only env that ships.
#
# Public vars (NEXT_PUBLIC_*) are inlined into the browser bundle.
# Server secrets are read only from lib/env.server.ts (import "server-only").
# Missing SUPABASE_SERVICE_ROLE_KEY / STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET
# throw at first use — the app will not silently run half-configured.
# =============================================================================

# --- App ---------------------------------------------------------------------
# REQUIRED. Canonical origin used for OAuth redirects and the Stripe portal return URL.
# Local: http://localhost:3000
# Prod:  https://your-domain.com  (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OPTIONAL. Browser-visible product name (metadata, emails, chrome).
NEXT_PUBLIC_APP_NAME="SaaSForge Elite"

# --- Database (Supabase Postgres) --------------------------------------------
# REQUIRED. Project URL from Supabase → Project Settings → API.
# Local CLI (`pnpm supabase:start`) serves the API at http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# OPTIONAL for the Next.js runtime (the app talks to Postgres through Supabase).
# Direct Postgres URL for the Supabase CLI, Studio, and ad-hoc SQL.
# Local default after `supabase start`:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Auth (Supabase) ---------------------------------------------------------
# REQUIRED (one of the two keys below). Browser-safe, RLS-bound.
# Dashboard → Project Settings → API → "anon" / "publishable" key.
# lib/env.ts accepts either name; prefer ANON_KEY and leave the alias blank.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# REQUIRED. Server-only. Bypasses RLS — never expose to the client.
# Dashboard → Project Settings → API → service_role. Used by Stripe webhooks.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# --- Stripe (subscription billing) -------------------------------------------
# REQUIRED to open the customer portal or process webhooks.
# Dashboard → Developers → API keys (use sk_test_ / pk_test_ until go-live).
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_PUBLISHABLE_KEY

# REQUIRED for POST /api/webhooks/stripe.
# Local: `pnpm stripe:listen` prints a whsec_… — paste it here and restart `pnpm dev`.
# Prod:  Dashboard → Developers → Webhooks → endpoint signing secret.
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_WEBHOOK_SECRET

# REQUIRED to map a tenant onto a plan (Starter / Growth / Enterprise).
# Dashboard → Product catalog → each recurring Price → copy price_…
STRIPE_PRICE_STARTER=price_YOUR_STARTER_PRICE_ID
STRIPE_PRICE_GROWTH=price_YOUR_GROWTH_PRICE_ID
STRIPE_PRICE_ENTERPRISE=price_YOUR_ENTERPRISE_PRICE_ID

# --- AI (LangChain / OpenAI agent pipeline) ----------------------------------
# REQUIRED once /api/ai/stream is wired to a real model. Safe to leave blank
# while using the local demo stream in the chat UI.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-YOUR_OPENAI_KEY

# OPTIONAL. LangSmith tracing. Off by default.
# https://smith.langchain.com/ → API key. Only needed if LANGCHAIN_TRACING_V2=true.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=saasforge-elite

# --- Security ----------------------------------------------------------------
# OPTIONAL. Redis URL for the production token-bucket limiter.
# Leave empty in local dev — the limiter falls back to in-memory.
# Example: redis://:password@127.0.0.1:6379/0
RATE_LIMIT_REDIS_URL=
